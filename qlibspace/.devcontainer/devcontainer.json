{
  "name": "Qlib Dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "qlib",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "forwardPorts": [8888],
  "postCreateCommand": "python -c 'import qlib; print(\"✅ Qlib ok:\", qlib.__version__)'"
}

